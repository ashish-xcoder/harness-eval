diff --git a/app/pricing.py b/app/pricing.py
index ee5f36b..384dbb3 100644
--- a/app/pricing.py
+++ b/app/pricing.py
@@ -20,3 +20,12 @@ def subtotal(order: Order) -> Decimal:
     total = sum((line_total(item) for item in order.items), Decimal("0"))
     logger.debug("subtotal for %d items: %s", len(order.items), total)
     return to_cents(total)
+
+
+def shipping_cost(order: Order, express: bool = False) -> Decimal:
+    order_subtotal = subtotal(order)
+    base_cost = Decimal("0") if order_subtotal >= Decimal("50.00") else Decimal("5.99")
+
+    if express:
+        return to_cents(base_cost + Decimal("10.00"))
+    return to_cents(base_cost)
