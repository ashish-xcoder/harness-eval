diff --git a/app/pricing.py b/app/pricing.py
index ee5f36b..cf5255f 100644
--- a/app/pricing.py
+++ b/app/pricing.py
@@ -20,3 +20,19 @@ def subtotal(order: Order) -> Decimal:
     total = sum((line_total(item) for item in order.items), Decimal("0"))
     logger.debug("subtotal for %d items: %s", len(order.items), total)
     return to_cents(total)
+
+
+def shipping_cost(order: Order, express: bool = False) -> Decimal:
+    order_subtotal = subtotal(order)
+
+    # Standard shipping: free if subtotal >= $50, otherwise $5.99
+    if order_subtotal >= Decimal("50.00"):
+        standard_cost = Decimal("0")
+    else:
+        standard_cost = Decimal("5.99")
+
+    # Express adds $10.00 on top
+    if express:
+        return to_cents(standard_cost + Decimal("10.00"))
+    else:
+        return to_cents(standard_cost)
