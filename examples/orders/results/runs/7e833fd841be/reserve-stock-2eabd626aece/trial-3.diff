+
+    def reserve(self, items: list[LineItem]) -> None:
+        for item in items:
+            if item.sku not in self._stock:
+                raise UnknownSku(item.sku)
+            if self._stock[item.sku] < item.quantity:
+                raise InsufficientStock(item.sku)
+        for item in items:
+            self._stock[item.sku] -= item.quantity
