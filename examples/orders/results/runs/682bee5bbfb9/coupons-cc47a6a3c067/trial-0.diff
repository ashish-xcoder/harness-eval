diff --git a/app/pricing.py b/app/pricing.py
index ee5f36b..944f343 100644
--- a/app/pricing.py
+++ b/app/pricing.py
@@ -1,6 +1,7 @@
 import logging
 from decimal import ROUND_HALF_UP, Decimal
 
+from app.errors import InvalidCoupon
 from app.models import LineItem, Order
 
 logger = logging.getLogger(__name__)
@@ -20,3 +21,16 @@ def subtotal(order: Order) -> Decimal:
     total = sum((line_total(item) for item in order.items), Decimal("0"))
     logger.debug("subtotal for %d items: %s", len(order.items), total)
     return to_cents(total)
+
+
+def apply_coupon(order: Order, code: str) -> Decimal:
+    sub = subtotal(order)
+    if code == "SAVE10":
+        discount = sub * Decimal("0.10")
+        result = sub - discount
+    elif code == "FLAT5":
+        discount = Decimal("5.00")
+        result = max(sub - discount, Decimal("0.00"))
+    else:
+        raise InvalidCoupon(f"coupon code '{code}' is not valid")
+    return to_cents(result)
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
index cf171c4..79aca56 100644
--- a/tests/test_pricing.py
+++ b/tests/test_pricing.py
@@ -2,9 +2,9 @@ from decimal import Decimal
 
 import pytest
 
-from app.errors import InvalidQuantity, OrderError
+from app.errors import InvalidCoupon, InvalidQuantity, OrderError
 from app.models import LineItem, Order
-from app.pricing import line_total, subtotal
+from app.pricing import apply_coupon, line_total, subtotal
 
 
 def test_line_total_multiplies_price_by_quantity():
@@ -24,3 +24,36 @@ def test_non_positive_quantity_is_rejected():
     with pytest.raises(InvalidQuantity):
         LineItem("A", Decimal("1.00"), 0)
     assert issubclass(InvalidQuantity, OrderError)
+
+
+def test_save10_coupon_applies_10_percent_discount():
+    order = Order([LineItem("A", Decimal("10.00"), 1)])
+    assert apply_coupon(order, "SAVE10") == Decimal("9.00")
+
+
+def test_save10_coupon_with_multiple_items():
+    order = Order([LineItem("A", Decimal("5.00"), 2), LineItem("B", Decimal("3.00"), 1)])
+    assert apply_coupon(order, "SAVE10") == Decimal("11.70")
+
+
+def test_flat5_coupon_applies_flat_discount():
+    order = Order([LineItem("A", Decimal("10.00"), 1)])
+    assert apply_coupon(order, "FLAT5") == Decimal("5.00")
+
+
+def test_flat5_coupon_does_not_go_below_zero():
+    order = Order([LineItem("A", Decimal("2.00"), 1)])
+    assert apply_coupon(order, "FLAT5") == Decimal("0.00")
+
+
+def test_invalid_coupon_code_raises_error():
+    order = Order([LineItem("A", Decimal("10.00"), 1)])
+    with pytest.raises(InvalidCoupon):
+        apply_coupon(order, "BADCODE")
+    assert issubclass(InvalidCoupon, OrderError)
+
+
+def test_coupon_rounds_to_cents():
+    order = Order([LineItem("A", Decimal("10.01"), 1)])
+    result = apply_coupon(order, "SAVE10")
+    assert result == Decimal("9.01")
