([LineItem(\"A\", Decimal(\"10.01\"), 1)])\n    assert apply_coupon(order, \"SAVE10\") == Decimal(\"9.01\")\n\n\ndef test_apply_coupon_empty_order():\n    order = Order()\n    assert apply_coupon(order, \"SAVE10\") == Decimal(\"0.00\")\n    assert apply_coupon(order, \"FLAT5\") == Decimal(\"0.00\")","originalFile":"from decimal import Decimal\n\nimport pytest\n\nfrom app.errors import InvalidCoupon, InvalidQuantity, OrderError\nfrom app.models import LineItem, Order\nfrom app.pricing import apply_coupon, line_total, subtotal\n\n\ndef test_line_total_multiplies_price_by_quantity():\n    assert line_total(LineItem(\"A\", Decimal(\"2.50\"), 3)) == Decimal(\"7.50\")\n\n\ndef test_subtotal_sums_lines():\n    order = Order([LineItem(\"A\", Decimal(\"2.50\"), 2), LineItem(\"B\", Decimal(\"1.25\"), 1)])\n    assert subtotal(order) == Decimal(\"6.25\")\n\n\ndef test_empty_order_subtotal_is_zero():\n    assert subtotal(Order()) == Decimal(\"0.00\")\n\n\ndef test_non_positive_quantity_is_rejected():\n    with pytest.raises(InvalidQuantity):\n        LineItem(\"A\", Decimal(\"1.00\"), 0)\n    assert issubclass(InvalidQuantity, OrderError)\n","structuredPatch":[{"oldStart":24,"oldLines":3,"newStart":24,"newLines":41,"lines":["     with pytest.raises(InvalidQuantity):","         LineItem(\"A\", Decimal(\"1.00\"), 0)","     assert issubclass(InvalidQuantity, OrderError)","+","+","+def test_apply_coupon_save10_percent_discount():","+    order = Order([LineItem(\"A\", Decimal(\"10.00\"), 2)])","+    assert apply_coupon(order, \"SAVE10\") == Decimal(\"18.00\")","+","+","+def test_apply_coupon_flat5_dollar_off():","+    order = Order([LineItem(\"A\", Decimal(\"10.00\"), 2)])","+    assert apply_coupon(order, \"FLAT5\") == Decimal(\"15.00\")","+","+","+def test_apply_coupon_flat5_never_below_zero():","+    order = Order([LineItem(\"A\", Decimal(\"2.00\"), 1)])","+    assert apply_coupon(order, \"FLAT5\") == Decimal(\"0.00\")","+","+","+def test_apply_coupon_flat5_zero_after_discount():