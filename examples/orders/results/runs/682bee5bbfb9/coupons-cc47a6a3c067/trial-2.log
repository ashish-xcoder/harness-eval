{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ADbJ2TBiu8w4UnWKbUg4Wu","type":"tool_result","content":"1\tfrom decimal import Decimal\n2\t\n3\timport pytest\n4\t\n5\tfrom app.errors import InvalidQuantity, InvalidCoupon, OrderError\n6\tfrom app.models import LineItem, Order\n7\tfrom app.pricing import apply_coupon, line_total, subtotal\n8\t\n9\t\n10\tdef test_line_total_multiplies_price_by_quantity():\n11\t    assert line_total(LineItem(\"A\", Decimal(\"2.50\"), 3)) == Decimal(\"7.50\")\n12\t\n13\t\n14\tdef test_subtotal_sums_lines():\n15\t    order = Order([LineItem(\"A\", Decimal(\"2.50\"), 2), LineItem(\"B\", Decimal(\"1.25\"), 1)])\n16\t    assert subtotal(order) == Decimal(\"6.25\")\n17\t\n18\t\n19\tdef test_empty_order_subtotal_is_zero():\n20\t    assert subtotal(Order()) == Decimal(\"0.00\")\n21\t\n22\t\n23\tdef test_non_positive_quantity_is_rejected():\n24\t    with pytest.raises(InvalidQuantity):\n25\t        LineItem(\"A\", Decimal(\"1.00\"), 0)\n26\t    assert issubclass(InvalidQuantity, OrderError)\n27\t\n28\t\n29\tdef test_save10_coupon_applies_10_percent_discount():\n30\t    order = Order([LineItem(\"A\", Decimal(\"10.00\"), 1)])\n31\t    assert apply_coupon(order, \"SAVE10\") == Decimal(\"9.00\")\n32\t\n33\t\n34\tdef test_save10_coupon_rounds_half_up_to_cents():\n35\t    order = Order([LineItem(\"A\", Decimal(\"10.00\"), 1)])\n36\t    result = apply_coupon(order, \"SAVE10\")\n37\t    assert result == result.quantize(Decimal(\"0.01\"))\n38\t\n39\t\n40\tdef test_save10_coupon_with_rounding():\n41\t    order = Order([LineItem(\"A\", Decimal(\"9.99\"), 1)])\n42\t    assert apply_coupon(order, \"SAVE10\") == Decimal(\"8.99\")\n43\t\n44\t\n45\tdef test_flat5_coupon_applies_five_dollar_discount():\n46\t    order = Order([LineItem(\"A\", Decimal(\"10.00\"), 1)])\n47\t    assert apply_coupon(order, \"FLAT5\") == Decimal(\"5.00\")\n48\t\n49\t\n50\tdef test_flat5_coupon_does_not_go_below_zero():\n51\t    order = Order([LineItem(\"A\", Decimal(\"3.00\"), 1)])\n52\t    assert apply_coupon(order, \"FLAT5\") == Decimal(\"0.00\")\n53\t\n54\t\n55\tdef test_flat5_coupon_with_exact_five():\n56\t    order = Order([LineItem(\"A\", Decimal(\"5.00\"), 1)])\n57\t    assert apply_coupon(order, \"FLAT5\") == Decimal(\"0.00\")\n58\t\n59\t\n60\tdef test_invalid_coupon_code_raises_error():\n61\t    order = Order([LineItem(\"A\", Decimal(\"10.00\"), 1)])\n62\t    with pytest.raises(InvalidCoupon):\n63\t        apply_coupon(order, \"INVALID\")\n64\t    assert issubclass(InvalidCoupon, OrderError)\n65\t\n66\t\n67\tdef test_empty_order_with_coupon():\n68\t    order = Order()\n69\t    assert apply_coupon(order, \"SAVE10\") == Decimal(\"0.00\")\n70\t    assert apply_coupon(order, \"FLAT5\") == Decimal(\"0.00\")\n71\t"}]},"parent_tool_use_id":null,"session_id":"9c828910-7b5f-4a8b-a609-589cb0183dcf","uuid":"cf9877be-e828-4be9-9d7a-bfe51fd430f2","timestamp":"2026-10-07T13:20:37.044Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\.harness-eval-runs\\1bbf64a7497c\\workspace\\tests\\test_pricing.py","content":"from decimal import Decimal\n\nimport pytest\n\nfrom app.errors import InvalidQuantity, InvalidCoupon, OrderError\nfrom app.models import LineItem, Order\nfrom app.pricing import apply_coupon, line_total, subtotal\n\n\ndef test_line_total_multiplies_price_by_quantity():\n    assert line_total(LineItem(\"A\", Decimal(\"2.50\"), 3)) == Decimal(\"7.50\")\n\n\ndef test_subtotal_sums_lines():\n    order = Order([LineItem(\"A\", Decimal(\"2.50\"), 2), LineItem(\"B\", Decimal(\"1.25\"), 1)])\n    assert subtotal(order) == Decimal(\"6.25\")\n\n\ndef test_empty_order_subtotal_is_zero():\n    assert subtotal(Order()) == Decimal(\"0.00\")\n\n\ndef test_non_positive_quantity_is_rejected():\n    with pytest.raises(InvalidQuantity):\n        LineItem(\"A\", Decimal(\"1.00\"), 0)\n    assert issubclass(InvalidQuantity, OrderError)\n\n\ndef test_save10_coupon_applies_10_percent_discount():\n    order = Order([LineItem(\"A\", Decimal(\"10.00\"), 1)])\n    assert apply_coupon(order, \"SAVE10\") == Decimal(\"9.00\")\n\n\ndef test_save10_coupon_rounds_half_up_to_cents():\n    order = Order([LineItem(\"A\", Decimal(\"10.00\"), 1)])\n    result = apply_coupon(order, \"SAVE10\")\n    assert result == result.quantize(Decimal(\"0.01\"))\n\n\ndef test_save10_coupon_with_rounding():\n    order = Order([LineItem(\"A\", Decimal(\"9.99\"), 1)])\n    assert apply_coupon(order, \"SAVE10\") == Decimal(\"8.99\")\n\n\ndef test_flat5_coupon_applies_five_dollar_discount():\n    order = Order([LineItem(\"A\", Decimal(\"10.00\"), 1)])\n    assert apply_coupon(order, \"FLAT5\") == Decimal(\"5.00\")\n\n\ndef test_flat5_coupon_does_not_go_below_zero():\n    order = Order([LineItem(\"A\", Decimal(\"3.00\"), 1)])\n    assert apply_coupon(order, \"FLAT5\") == Decimal(\"0.00\")\n\n\ndef test_flat5_coupon_with_exact_five():\n    order = Order([LineItem(\"A\", Decimal(\"5.00\"), 1)])\n    assert apply_coupon(order, \"FLAT5\") == Decimal(\"0.00\")\n\n\ndef test_invalid_coupon_code_raises_error():\n    order = Order([LineItem(\"A\", Decimal(\"10.00\"), 1)])\n    with pytest.raises(InvalidCoupon):\n        apply_coupon(order, \"INVALID\")\n    assert issubclass(InvalidCoupon, OrderError)\n\n\ndef test_empty_order_with_coupon():\n    order = Order()\n    assert apply_coupon(order, \"SAVE10\") == Decimal(\"0.00\")\n    assert apply_coupon(order, \"FLAT5\") == Decimal(\"0.00\")\n","numLines":71,"startLine":1,"totalLines":71}}}
