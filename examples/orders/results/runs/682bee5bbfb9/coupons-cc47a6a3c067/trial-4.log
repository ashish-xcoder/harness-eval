"A\", Decimal(\"10.00\"), 1)])\n    assert apply_coupon(order, \"SAVE10\") == Decimal(\"9.00\")\n\n\ndef test_apply_coupon_save10_on_complex_order():\n    order = Order([LineItem(\"A\", Decimal(\"2.50\"), 2), LineItem(\"B\", Decimal(\"1.25\"), 1)])\n    assert apply_coupon(order, \"SAVE10\") == Decimal(\"5.625\").quantize(Decimal(\"0.01\"))\n\n\ndef test_apply_coupon_flat5_subtracts_5_dollars():\n    order = Order([LineItem(\"A\", Decimal(\"10.00\"), 1)])\n    assert apply_coupon(order, \"FLAT5\") == Decimal(\"5.00\")\n\n\ndef test_apply_coupon_flat5_never_goes_below_zero():\n    order = Order([LineItem(\"A\", Decimal(\"2.00\"), 1)])\n    assert apply_coupon(order, \"FLAT5\") == Decimal(\"0.00\")\n\n\ndef test_apply_coupon_invalid_code_raises_error():\n    order = Order([LineItem(\"A\", Decimal(\"10.00\"), 1)])\n    with pytest.raises(InvalidCoupon):\n        apply_coupon(order, \"INVALID\")\n    assert issubclass(InvalidCoupon, OrderError)\n\n\ndef test_apply_coupon_empty_order():\n    order = Order()\n    assert apply_coupon(order, \"SAVE10\") == Decimal(\"0.00\")\n    assert apply_coupon(order, \"FLAT5\") == Decimal(\"0.00\")\n","structuredPatch":[{"oldStart":33,"oldLines":7,"newStart":33,"newLines":7,"lines":[" "," def test_apply_coupon_save10_on_complex_order():","     order = Order([LineItem(\"A\", Decimal(\"2.50\"), 2), LineItem(\"B\", Decimal(\"1.25\"), 1)])","-    assert apply_coupon(order, \"SAVE10\") == Decimal(\"5.625\").quantize(Decimal(\"0.01\"))","+    assert apply_coupon(order, \"SAVE10\") == Decimal(\"5.63\")"," "," "," def test_apply_coupon_flat5_subtracts_5_dollars():"]}],"userModified":false,"replaceAll":false}}
