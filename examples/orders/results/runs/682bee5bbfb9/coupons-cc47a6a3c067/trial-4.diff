diff --git a/app/pricing.py b/app/pricing.py
index ee5f36b..7ec3bb8 100644
--- a/app/pricing.py
+++ b/app/pricing.py
@@ -1,6 +1,7 @@
 import logging
 from decimal import ROUND_HALF_UP, Decimal
 
+from app.errors import InvalidCoupon
 from app.models import LineItem, Order
 
 logger = logging.getLogger(__name__)
@@ -20,3 +21,19 @@ def subtotal(order: Order) -> Decimal:
     total = sum((line_total(item) for item in order.items), Decimal("0"))
     logger.debug("subtotal for %d items: %s", len(order.items), total)
     return to_cents(total)
+
+
+def apply_coupon(order: Order, code: str) -> Decimal:
+    amount = subtotal(order)
+    if code == "SAVE10":
+        discount = amount * Decimal("0.10")
+        result = amount - discount
+        logger.debug("applying SAVE10 coupon: %s - %s = %s", amount, discount, result)
+        return to_cents(result)
+    elif code == "FLAT5":
+        discount = Decimal("5.00")
+        result = max(amount - discount, Decimal("0.00"))
+        logger.debug("applying FLAT5 coupon: %s - %s = %s", amount, discount, result)
+        return to_cents(result)
+    else:
+        raise InvalidCoupon(f"Unknown coupon code: {code}")
