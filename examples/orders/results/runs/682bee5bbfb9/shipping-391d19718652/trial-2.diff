diff --git a/app/pricing.py b/app/pricing.py
index ee5f36b..e934f1b 100644
--- a/app/pricing.py
+++ b/app/pricing.py
@@ -20,3 +20,22 @@ def subtotal(order: Order) -> Decimal:
     total = sum((line_total(item) for item in order.items), Decimal("0"))
     logger.debug("subtotal for %d items: %s", len(order.items), total)
     return to_cents(total)
+
+
+def shipping_cost(order: Order, express: bool = False) -> Decimal:
+    order_subtotal = subtotal(order)
+    free_shipping_threshold = Decimal("50.00")
+    standard_shipping = Decimal("5.99")
+    express_shipping = Decimal("10.00")
+
+    if order_subtotal >= free_shipping_threshold:
+        base_cost = Decimal("0")
+    else:
+        base_cost = standard_shipping
+
+    if express:
+        cost = base_cost + express_shipping
+    else:
+        cost = base_cost
+
+    return to_cents(cost)
