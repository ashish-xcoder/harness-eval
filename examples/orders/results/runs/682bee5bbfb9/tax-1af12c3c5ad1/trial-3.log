en(order.items), total)\n    return to_cents(total)\n\n\ndef tax(order: Order) -> Decimal:\n    rate = Decimal(\"0\")\n    if order.region == \"CA\":\n        rate = Decimal(\"0.0725\")\n    elif order.region == \"NY\":\n        rate = Decimal(\"0.04\")\n\n    sub = subtotal(order)\n    tax_amount = sub * rate\n    return to_cents(tax_amount)\n","numLines":35,"startLine":1,"totalLines":35}}}
