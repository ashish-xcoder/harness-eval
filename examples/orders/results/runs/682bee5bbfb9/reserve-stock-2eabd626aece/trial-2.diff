 import pytest
+from decimal import Decimal
 
-from app.errors import UnknownSku
+from app.errors import InsufficientStock, UnknownSku
 from app.inventory import Inventory
+from app.models import LineItem
 
 
 def test_available_returns_stock():
@@ -11,3 +13,43 @@ def test_available_returns_stock():
 def test_unknown_sku_raises():
     with pytest.raises(UnknownSku):
         Inventory({}).available("missing")
+
+
+def test_reserve_successful():
+    inv = Inventory({"A": 10, "B": 5})
+    items = [LineItem("A", Decimal("10"), 3), LineItem("B", Decimal("20"), 2)]
+    inv.reserve(items)
+    assert inv.available("A") == 7
+    assert inv.available("B") == 3
+
+
+def test_reserve_unknown_sku():
+    inv = Inventory({"A": 10})
+    items = [LineItem("A", Decimal("10"), 3), LineItem("Z", Decimal("20"), 1)]
+    with pytest.raises(UnknownSku):
+        inv.reserve(items)
+    assert inv.available("A") == 10
+
+
+def test_reserve_insufficient_stock():
+    inv = Inventory({"A": 5})
+    items = [LineItem("A", Decimal("10"), 10)]
+    with pytest.raises(InsufficientStock):
+        inv.reserve(items)
+    assert inv.available("A") == 5
+
+
+def test_reserve_all_or_nothing():
+    inv = Inventory({"A": 5, "B": 10})
+    items = [LineItem("A", Decimal("10"), 2), LineItem("B", Decimal("20"), 15)]
+    with pytest.raises(InsufficientStock):
+        inv.reserve(items)
+    assert inv.available("A") == 5
+    assert inv.available("B") == 10
+
+
+def test_reserve_multiple_items_same_sku():
+    inv = Inventory({"A": 10})
+    items = [LineItem("A", Decimal("10"), 3), LineItem("A", Decimal("10"), 2)]
+    inv.reserve(items)
+    assert inv.available("A") == 5
