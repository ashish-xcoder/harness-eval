 logger = logging.getLogger(__name__)
 
@@ -13,3 +14,17 @@ class Inventory:
         if sku not in self._stock:
             raise UnknownSku(sku)
         return self._stock[sku]
+
+    def reserve(self, items: list[LineItem]) -> None:
+        needed = {}
+        for item in items:
+            if item.sku not in self._stock:
+                raise UnknownSku(item.sku)
+            needed[item.sku] = needed.get(item.sku, 0) + item.quantity
+
+        for sku, quantity in needed.items():
+            if self._stock[sku] < quantity:
+                raise InsufficientStock(f"insufficient stock for {sku}")
+
+        for sku, quantity in needed.items():
+            self._stock[sku] -= quantity
